# Copy to frontend/.env only if you need to point the frontend at a non-default
# API URL (e.g. a deployed backend). Leave blank for normal local dev -- Vite's
# dev-server proxy (see vite.config.js) forwards /api requests to the Python
# backend automatically. The Razorpay key id does NOT need to be set here --
# the backend hands it to the frontend per-order from its own .env.
VITE_API_URL=
